# Oxylabs API Credentials
# Get your credentials from https://oxylabs.io/
OXYLABS_USERNAME=your_oxylabs_username_here
OXYLABS_PASSWORD=your_oxylabs_password_here

# OpenAI API Key
# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Optional settings
# OPENAI_MODEL=gpt-4o-mini
# MAX_COMPETITORS=20      # competitors scraped per analysis (each is a paid request)
# SEARCH_PAGES=2          # search pages per sort order
# DB_PATH=data.json
